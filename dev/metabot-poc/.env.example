# This file is safe to commit. Copy it to .env and replace the password locally.
# Do not put an LLM API key here; configure the provider through Metabase Admin
# after the local instance is working.

METABOT_APP_DB_NAME=metabot
METABOT_APP_DB_USER=metabot
METABOT_APP_DB_PASSWORD=replace-with-a-long-local-password

# Change this if port 3000 is already used on the host.
METABOT_HOST_PORT=3000
METABOT_SITE_URL=http://localhost:3000

# Label embedded in the locally built Metabase artifact.
METABOT_BUILD_VERSION=v0.63.1.6-metabot-poc

# --- LLM provider -----------------------------------------------------------
# Switching provider means changing this one line; leave both keys in place.
#   anthropic/claude-sonnet-4-6     (default)
#   openai/gpt-5.4
# Any model name the provider accepts works — Metabase validates the provider
# prefix, not the model.
MB_LLM_METABOT_PROVIDER=anthropic/claude-sonnet-4-6

# Must begin with sk-ant-. Set through the environment, the prefix check that
# the Admin UI would run is skipped, so a malformed key fails at call time
# rather than when you save it.
MB_LLM_ANTHROPIC_API_KEY=
# Only needed to route through a proxy or gateway.
MB_LLM_ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# Must begin with sk-.
MB_LLM_OPENAI_API_KEY=
MB_LLM_OPENAI_API_BASE_URL=https://api.openai.com

# The 4096 default is too small for a reasoning model: the thinking alone can
# exhaust it before the model ever emits a tool call, which surfaces as Metabot
# answering with no query behind it rather than as an error.
MB_LLM_MAX_TOKENS=16384

# --- BI warehouse -----------------------------------------------------------
# Superuser for the warehouse container. load_warehouse.py uses this to apply
# DDL and create the reader role.
WAREHOUSE_DB=bi_warehouse
WAREHOUSE_USER=postgres
WAREHOUSE_PASSWORD=replace-with-a-long-local-password
WAREHOUSE_HOST_PORT=5433

# Least-privilege login Metabase uses for the BI connection. Only ever granted
# SELECT on the analytics schema. Leave the password unset to skip creating it.
WAREHOUSE_READER_USER=metabase_reader
WAREHOUSE_READER_PASSWORD=replace-with-a-different-long-local-password

# --- Metabase admin ---------------------------------------------------------
# provision_metabase.py creates this account on first run, then logs in with it
# on later runs. Metabase rejects weak passwords.
METABOT_ADMIN_EMAIL=admin@metabot.local
METABOT_ADMIN_PASSWORD=replace-with-a-long-local-password

# Tên hiển thị của datasource và collection do script tạo.
METABOT_DB_NAME=BI Warehouse
METABOT_COLLECTION_NAME=BI Analytics

# Where the Silver/Gold CSVs live. Defaults to local-context/data/pipeline at
# the repo root, which is where they already are — only set this to point
# somewhere else. A relative path resolves against the repo root.
# WAREHOUSE_PIPELINE_DIR=local-context/data/pipeline
