# This file is safe to commit. Copy it to .env and replace the password locally.
# Do not put an LLM API key here; configure the provider through Metabase Admin
# after the local instance is working.

METABOT_APP_DB_NAME=metabot
METABOT_APP_DB_USER=metabot
METABOT_APP_DB_PASSWORD=replace-with-a-long-local-password

# Change this if port 3000 is already used on the host.
METABOT_HOST_PORT=3000
METABOT_SITE_URL=http://localhost:3000

# Label embedded in the locally built Metabase artifact.
METABOT_BUILD_VERSION=v0.63.1.6-metabot-poc
