# This file is safe to commit. Copy it to .env and replace the password locally.
# Do not put an LLM API key here; configure the provider through Metabase Admin
# after the local instance is working.

METABOT_APP_DB_NAME=metabot
METABOT_APP_DB_USER=metabot
METABOT_APP_DB_PASSWORD=replace-with-a-long-local-password

# Change this if port 3000 is already used on the host.
METABOT_HOST_PORT=3000
METABOT_SITE_URL=http://localhost:3000

# Label embedded in the locally built Metabase artifact.
METABOT_BUILD_VERSION=v0.63.1.6-metabot-poc

# --- BI warehouse -----------------------------------------------------------
# Superuser for the warehouse container. load_warehouse.py uses this to apply
# DDL and create the reader role.
WAREHOUSE_DB=bi_warehouse
WAREHOUSE_USER=postgres
WAREHOUSE_PASSWORD=replace-with-a-long-local-password
WAREHOUSE_HOST_PORT=5433

# Least-privilege login Metabase uses for the BI connection. Only ever granted
# SELECT on the analytics schema. Leave the password unset to skip creating it.
WAREHOUSE_READER_USER=metabase_reader
WAREHOUSE_READER_PASSWORD=replace-with-a-different-long-local-password

# Where the Silver/Gold CSVs live. Defaults to local-context/data/pipeline at
# the repo root, which is where they already are — only set this to point
# somewhere else. A relative path resolves against the repo root.
# WAREHOUSE_PIPELINE_DIR=local-context/data/pipeline
