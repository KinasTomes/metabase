# Custom merge driver for per-release YAML migration files.
# Treats each changeset as an atomic unit to avoid conflicts within changesets.
# Only applies to per-release *_update_migrations.yaml files — directory-based
# migrations (e.g. 060/*.yaml) have one file per migration and don't need this.
# Execute this in your shell to enable custom merge driver:
# echo '\n[include]\npath=../.gitconfig' >> .git/config
#
# TODO (Bryan 12/12/25) -- reenable this when we can completely verify correctness
# resources/migrations/*_update_migrations.yaml merge=yaml-migrations

# Shell scripts must keep LF endings even when checked out on Windows with
# core.autocrlf=true. A CRLF checkout turns the shebang into "#!/bin/bash\r",
# and any image that COPYs the script straight from the build context dies at
# startup with "no such file or directory" — the kernel is looking for an
# interpreter literally named /bin/bash\r.
*.sh text eol=lf

# Generated API documentation/specs — regenerated by the "Auto-update documentation for master"
# CI automation, not edited by hand. Mark generated so tools/humans don't review or diff them as source.
docs/api.json                  linguist-generated
docs/api.html                  linguist-generated
resources/openapi/openapi.json linguist-generated
